{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "web-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "DayTrading",
        "start"
      ],
      "port": 8081
    },
    {
      "name": "game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "omniverse-game",
        "run",
        "dev"
      ],
      "port": 5199
    },
    {
      "name": "frat-game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frat-game",
        "run",
        "dev"
      ],
      "port": 5200
    },
    {
      "name": "zombies-game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "zombies-game",
        "run",
        "dev"
      ],
      "port": 5300
    }
  ]
}
