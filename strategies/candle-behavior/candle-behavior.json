{
  "id": "candle-behavior",
  "name": "Candle Behavior Specification",
  "version": "1.0",
  "locked": true,
  "lastUpdatedBy": null,
  "lastUpdatedAt": null,
  "type": "system-spec",
  "description": "Single source of truth for candle creation, validation, storage, broadcast, and rendering.",
  "sections": [
    "candle-data-structure",
    "validation-rules",
    "timestamp-alignment",
    "storage-rules",
    "live-candle-rules",
    "client-merge-rules",
    "interval-switch-rules",
    "data-page-rules",
    "prohibited-behaviors",
    "debugging-reference"
