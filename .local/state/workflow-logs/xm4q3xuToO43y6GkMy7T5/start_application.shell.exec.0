,"low":671.65,"close":671.75,"volume":5295,"rth":false},{"time":1772841000,"open":671.78,"high":671.79,"low":671.61,"close":671.75,"volume":3636,"rth":false},{"time":1772841300,"open":671.71,"high":671.73,"low":671.5206,"close":671.6504,"volume":11608,"rth":false},{"time":1772841600,"open":671.66,"high":671.7,"low":671.64,"close":671.64,"volume":3411,"rth":false},{"time":1772841900,"open":671.68,"high":671.69,"low":671.61,"close":671.66,"volume":4405,"rth":false},{"time":1772842200,"open":671.68,"high":671.6999,"low":671.66,"close":671.69,"volume":855,"rth":false},{"time":1772842500,"open":671.7,"high":671.74,"low":671.67,"close":671.7,"volume":2896,"rth":false},{"time":1772842800,"open":671.75,"high":671.75,"low":671.67,"close":671.67,"volume":2949,"rth":false},{"time":1772843100,"open":671.68,"high":671.7,"low":671.65,"close":671.7,"volume":1893,"rth":false},{"time":1772843400,"open":671.64,"high":671.67,"low":671.62,"close":671.67,"volume":1894,"rth":false},{"time":1772843700,"open":671.66,"high":671.66,"low":671.52,"close":671.52,"volume":2068,"rth":false},{"time":1772844000,"open":671.54,"high":671.61,"low":671.53,"close":671.54,"volume":3569,"rth":false},{"time":1772844300,"open":671.53,"high":671.6,"low":671.52,"close":671.52,"volume":5325,"rth":false},{"time":1772844600,"open":671.53,"high":671.53,"low":671.4543,"close":671.46,"volume":4626,"rth":false},{"time":1772844900,"open":671.4456,"high":671.5,"low":671.3,"close":671.3,"volume":7068,"rth":false}],"source":"cached"}
