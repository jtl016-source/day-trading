2,"dash":"4,4"},"text":{"font":"Arial|12|B","fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"underlay":true,"srcId":"component;support","info":true,"coords":["1718189099957|5792.25|topLeft","1718222321232|5792.25|topRight","1718189099957|5786.25|bottomLeft","1718222321232|5786.25|bottomRight"]},{"type":"comment","id":113235,"text":{"text":"SUPPORTIVE ","font":"Arial|14.5|B","fg":"255,215,0"},"underlay":true,"srcId":"component;comment","width":101,"coords":["1718205091373|5788.76519214137|center"]},{"type":"comment","id":113236,"text":{"text":"MID BUYER ACCUMULATION POSITIONING 5322-28","font":"Arial|12|B","fg":"255,255,255"},"srcId":"component;comment","width":160,"coords":["1718177774984|5789.39775176959|center"]},{"type":"supportResist","id":113237,"fillColor":"240,0,0,36","fill":true,"line":{"width":2,"dash":"4,4"},"text":{"font":"Arial|12|B","fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"underlay":true,"srcId":"component;support","info":true,"coords":["1718189149959|5826.25|topLeft","1718222371232|5826.25|topRight","1718189149959|5824.25|bottomLeft","1718222371232|5824.25|bottomRight"]},{"type":"comment","id":113238,"text":{"text":" SELLER OBJECTIVE","font":"Arial|14.5|B","fg":"255,215,0"},"underlay":true,"srcId":"component;comment","width":152,"coords":["1718204933042|5825.21152693519|center"]},{"type":"comment","id":113239,"text":{"text":"8:30 am\n\uD83D\uDD34 US CORE CPI MOM ACTUAL 0.2% (FORECAST 0.3%, PREVIOUS 0.3%) \n\uD83D\uDD34 \u26A0\uFE0F BREAKING: US CPI YOY ACTUAL 3.3% (FORECAST 3.4%, PREVIOUS 3.4%) \n\uD83D\uDD34 US CORE CPI YOY ACTUAL 3.4% (FORECAST 3.5%, PREVIOUS 3.6%) \n\uD83D\uDD34 US CPI MOM ACTUAL 0% (FORECAST 0.1%, PREVIOUS 0.3%) \n\uD83D\uDD34 US SHORT-TERM INTEREST-RATE FUTURES JUMP AFTER INFLATION DATA; TRADERS PRICE IN A BIGGER CHANCE OF FED RATE CUTS.\n\uD83D\uDD34 US INTEREST-RATE FUTURES NOW IMPLY ABOUT 70% CHANCE OF A FED RATE CUT BY SEPTEMBER","font":"Arial|10|B","fg":"255,215,0"},"srcId":"component;comment","width":453,"coords":["1718167399993|5927.17991533839|center"]},{"type":"comment","id":113284,"text":{"text":"2:00 pm\n\uD83D\uDD34 \u26A0\uFE0F BREAKING: US INTEREST RATE DECISION ACTUAL 5.5% (FORECAST 5.5%, PREVIOUS 5.5%) $MACRO\nSUMMARY OF ECONOMIC PROJECTIONS - READ HERE https://www.federalreserve.gov/monetarypolicy/files/fomcprojtabl20240612.pdf\n\uD83D\uDD34 FED: DOES NOT EXPECT IT WILL BE APPROPRIATE TO REDUCE POLICY TARGET RANGE UNTIL GAINING GREATER CONFIDENCE INFLATION IS MOVING SUSTAINABLY TOWARD 2%.\n\uD83D\uDD34 FED OFFICIALS' MEDIAN VIEW OF FED FUNDS RATE AT END-2024 5.1% (PREV 4.6%).\n\uD83D\uDD34 FED OFFICIALS' MEDIAN VIEW OF FED FUNDS RATE IN LONGER RUN 2.8% (PREV 2.6%).\nFED: INFLATION HAS EASED OVER THE PAST YEAR BUT REMAINS ELEVATED.\n\uD83D\uDD34 \u26A0\uFE0F BREAKING: FED OFFICIALS MEDIAN VIEW OF THE FED FUNDS RATE AT END-2024 5.1% (PREV 4.6%).\nFED: RISKS TO ACHIEVING POLICY GOALS HAVE MOVED TOWARD BETTER BALANCE.\nFED: THE ECONOMY CONTINUES TO EXPAND AT SOLID PACE, JOB GAINS REMAIN STRONG, UNEMPLOYMENT RATE REMAINS LOW.\n\uD83D\uDD34 FED PROJECTIONS IMPLY 25 BPS OF RATE CUTS IN 2024 FROM CURRENT LEVEL, ANOTHER 100 BPS IN 2025.\n\uD83D\uDD34 FED: VOTE IN FAVOR OF POLICY WAS UNANIMOUS.\nFED: WE WILL CONTINUE TO REDUCE HOLDINGS OF TREASURY SECURITIES AND MORTGAGE-BACKED SECURITIES.\n\uD83D\uDD34 FED PROJECTIONS SHOW 4 OF 19 OFFICIALS SAW NO RATE CUT IN 2024; 7 SAW 1 CUT; 8 SAW 2 CUTS.\n\uD83D\uDD34 FED PROJECTIONS SHOW 4 OF 19 OFFICIALS SAW NO RATE CUT IN 2024; 7 SAW 1 CUT; 8 SAW 2 CUTS.\nFED: THERE HAS BEEN MODEST FURTHER PROGRESS TOWARD 2% INFLATION OBJECTIVE VS LACK OF PROGRESS CITED IN MAY 1 STATEMENT.\n\uD83D\uDD34 FED POLICYMAKERS SEE END-2024 PCE INFLATION AT 2.6% VERSUS 2.4% IN THE MARCH PROJECTION, CORE SEEN AT 2.8% VERSUS 2.6%.\n\uD83D\uDD34 FORECASTS SHOW 2025 PCE AND CORE PCE INFLATION AT 2.3% VERSUS 2.2% IN MARCH.","font":"Arial|10|B","fg":"255,215,0"},"srcId":"component;comment","width":895,"coords":["1718190399991|5732.56468203896|center"]},{"type":"supportResist","id":113309,"fillColor":"0,0,240,0","fill":true,"line":{"color":"255,255,255","width":2,"dash":"3,3"},"text":{"font":"Arial|12|B","fg":"245,245,245"},"srcId":"component;support","info":true,"coords":["1718229646143|5973.25|topLeft","1718316000000|5973.25|topRight","1718229646143|5824|bottomLeft","1718316000000|5824|bottomRight"]},{"type":"supportResist","id":113310,"fillColor":"240,0,0,70","fill":true,"line":{"dash":"17,8"},"text":{"font":"Arial|12","fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"srcId":"component;resist","info":true,"coords":["1718229650000|5968|topLeft","1718315849999|5968|topRight","1718229650000|5916.25|bottomLeft","1718315849999|5916.25|bottomRight"]},{"type":"supportResist","id":113311,"fillColor":"255,215,0,40","fill":true,"text":{"fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"srcId":"component;support","info":true,"showLines":false,"coords":["1718229649994|5907.75|topLeft","1718316046153|5907.75|topRight","1718229649994|5897.75|bottomLeft","1718316046153|5897.75|bottomRight"]},{"type":"supportResist","id":113312,"fillColor":"0,255,0,79","fill":true,"line":{"dash":"17,8"},"text":{"fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"underlay":true,"srcId":"component;support","info":true,"coords":["1718229649991|5889|topLeft","1718316046153|5889|topRight","1718229649991|5866|bottomLeft","1718316046153|5866|bottomRight"]},{"type":"supportResist","id":113313,"fillColor":"0,0,240,0","fill":true,"line":{"color":"255,215,0","width":0.75,"dash":"17,8"},"text":{"fg":"245,245,245","bg":"0,0,0","border":"245,245,245"},"srcId":"component;support","info":true,"coords":["1718229600000|5902.75|topLeft","1718315349986|5902.75|topRight","1718229600000|5893|bottomLeft","1718315349986|5893|bottomRight"]},{"type":"supportResist","id":113314,"fillColor":"0,0,240,0","fill":true,"line":{"color":"255,255,255","width":1.5,"dash":"21,4,4,4"},"text":{"font":"Arial|12","fg":"245,245,245","bg":"0,0,0","border":"245,245,24